# Set locally to a WebSocket endpoint you are authorized to access.
# The endpoint has not been verified by this project.
CRASH_WS_URL=
WS_TIMEOUT_SECONDS=15
MAX_MESSAGES=100

# Optional schema mapping. Leave ALL parser fields blank until verified against
# sanitized messages and compared with the site's visible completed-round history.
CRASH_EVENT_TYPE_PATH=
CRASH_FINAL_EVENT_TYPES=
CRASH_ROUND_ID_PATH=
CRASH_MULTIPLIER_PATH=
CRASH_TIMESTAMP_PATH=
CRASH_SCHEMA_VERSION=unconfirmed

# Example only (not a claim about any target site's actual protocol):
# CRASH_EVENT_TYPE_PATH=type
# CRASH_FINAL_EVENT_TYPES=round.completed
# CRASH_ROUND_ID_PATH=data.round.id
# CRASH_MULTIPLIER_PATH=data.round.multiplier
# CRASH_TIMESTAMP_PATH=data.ended_at
# CRASH_SCHEMA_VERSION=manually-confirmed-v1
